*.agents
*.json

# Public, non-sensitive provenance manifests versioned with the territorial workflow.
!deepgravity/data/santiago/reference/*_metadata.json
!docs/territorio/f2d/*.json
!docs/territorio/f2e/*.json
!docs/territorio/f2f/*.json
!docs/territorio/f2i/*.json
!docs/verificacion/f2g/*.json
!docs/experimentos/f2h/*.json
!config/*.example.json

# Local machine settings and credentials
.env
.env.*
!*.example
config/*.local.env
config/*.local.toml
config/*.local.yaml

# DTPM raw data and derived artefacts (kept outside version control)
deepgravity/data/santiago/raw/
deepgravity/data/santiago/interim/
deepgravity/data/santiago/processed/
deepgravity/data/santiago/cache/
deepgravity/data/santiago/checkpoints/
deepgravity/results/santiago/
runs/
tests/.artifacts/
.f2i_deps/

# Common runtime by-products
__pycache__/
*.py[cod]
.ipynb_checkpoints/
